From Mon Sep 17 00:00:00 2001
From: DryhoppedIPA <DryhoppedIPA@github.com>
Date: Sat, 8 Aug 2026 04:53:11 +0000
Subject: [PATCH 1/3] radv,ac: GFX1013 compute queue exposure lifecycle layer

---
 src/amd/common/ac_gpu_info.c | 14 ++++++++------
 1 file changed, 8 insertions(+), 6 deletions(-)

diff --git a/src/amd/common/ac_gpu_info.c b/src/amd/common/ac_gpu_info.c
index 6e4c0b0..49bd824 100644
--- a/src/amd/common/ac_gpu_info.c
+++ b/src/amd/common/ac_gpu_info.c
@@ -433,10 +433,10 @@ ac_fill_hw_ip_info(struct radeon_info *info, const struct drm_amdgpu_info_device
        */
       info->ip[ip_type].num_queues = 1;
    } else if (ip_info->available_rings) {
-      /* GFX1013 is known to have broken compute queue */
-      if (ip_type == AMD_IP_COMPUTE && device_info->family == FAMILY_NV &&
-          ASICREV_IS(device_info->external_rev, GFX1013))
-         return false;
+      /* GFX1013: the compute queue is exposed unconditionally. This driver
+       * must run only on a kernel carrying the V33 compute-queue lifecycle
+       * repair; on stock GFX1013 kernels the queue must stay closed.
+       */
 
       info->ip[ip_type].num_queues = util_bitcount(ip_info->available_rings);
    }
@@ -454,7 +454,8 @@ ac_fill_hw_ip_info(struct radeon_info *info, const struct drm_amdgpu_info_device
       if (device_info->family == FAMILY_NV &&
             (ASICREV_IS(device_info->external_rev, NAVI10) ||
             ASICREV_IS(device_info->external_rev, NAVI12) ||
-            ASICREV_IS(device_info->external_rev, NAVI14)))
+            ASICREV_IS(device_info->external_rev, NAVI14) ||
+            ASICREV_IS(device_info->external_rev, GFX1013)))
          info->ip[AMD_IP_GFX].ver_minor = info->ip[AMD_IP_COMPUTE].ver_minor = 1;
       else if (device_info->family == FAMILY_NV ||
                device_info->family == FAMILY_VGH ||
@@ -968,7 +469,8 @@ void ac_fill_bug_info(struct radeon_info *info)
     * dimension mode.
     */
    info->has_async_compute_threadgroup_bug = info->family == CHIP_ICELAND ||
-                                             info->family == CHIP_TONGA;
+                                             info->family == CHIP_TONGA ||
+                                             info->family == CHIP_GFX1013;
 
    /* GFX7 CP requires 32 bytes alignment for the indirect buffer arguments on
     * the compute queue.
-- 
